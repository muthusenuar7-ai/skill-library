# Copy to .env (never commit .env). manage.py defaults to DJANGO_ENV=development; gunicorn/wsgi defaults to production.
DJANGO_ENV=development
DJANGO_DEBUG=True

# REQUIRED when DJANGO_DEBUG is off. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# Comma separated host names (production). Example: skills.example.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma separated origins incl. scheme, needed behind HTTPS proxies. Example: https://skills.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# HTTPS behaviour (defaults: on when DEBUG is off)
# DJANGO_HTTPS=True
# DJANGO_SSL_REDIRECT=True
# DJANGO_BEHIND_PROXY=True      # set only if a trusted proxy sets X-Forwarded-Proto

# Database: SQLite by default. For production use PostgreSQL:
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
# SQLITE_PATH=

# Where uploaded files / import attachments are stored. MUST be a persistent disk in production.
# PRIVATE_MEDIA_ROOT=/var/data/private_media
# On Vercel, use the connected PRIVATE Blob store for uploads AND import staging:
# PRIVATE_MEDIA_STORAGE=vercel_blob
# BLOB_READ_WRITE_TOKEN=  # managed by the Vercel storage connection; never commit it

# Public address, used in invitation e-mails (otherwise the request host is used)
# SITE_URL=https://skills.example.com

# E-mail for activation invitations / password resets. If EMAIL_HOST is empty the app shows a setup link instead.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Datacense Skill Library <no-reply@datasense.com>

# Optional tuning
# COLLECTION_MAX_SKILLS=100        # skills per My Collection / favorites ZIP
# COLLECTION_MAX_BYTES=52428800  # uncompressed size limit of a ZIP download
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCKOUT_SECONDS=900
# ACTIVATION_LINK_TIMEOUT=259200
# IMPORT_MAX_UPLOAD_BYTES=26214400
# IMPORT_MAX_FILES=500
# IMPORT_MAX_UNCOMPRESSED_BYTES=52428800
